# Copy this file to .env and fill in the values. Never commit .env.
#   cp .env.example .env && chmod 600 .env

# App key from https://www.developer.saxo/openapi/appmanagement (register the
# app with "Authorization Code Grant with PKCE" and trading permission DISABLED).
SAXO_APP_KEY=

# Environment. Only "sim" is supported during development. "live" is refused
# unless SAXO_ALLOW_LIVE=1 is also set (see README before you ever do that).
SAXO_ENV=sim

# Redirect URI you registered for the app. The port is the local callback
# server that `npm run login` starts to catch the OAuth redirect.
SAXO_REDIRECT_URI=http://localhost:8765/callback

# Where tokens are stored (JSON file, created with mode 0600). Default shown.
# SAXO_TOKEN_FILE=.saxo-tokens.json

# Trading hard block. Default: disabled. The four order tools (precheck_order,
# place_order, modify_order, cancel_order) are only registered, and the HTTP
# client only allows POST/PATCH/DELETE, when this is EXACTLY "enabled".
# Any other value ("1", "true", "on") is rejected at startup.
# SAXO_TRADING=disabled

# --- HTTP transport (dist/http-server.js) only; the stdio server ignores these ---
# Long random secret clients must send as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32   (minimum 32 characters; never commit it)
MCP_ACCESS_TOKEN=
# Local port the HTTP server listens on (127.0.0.1 only; Caddy proxies to it).
HTTP_PORT=3000
# Optional: extra Host header values to accept, comma-separated. Not needed with
# the provided Caddyfile, which forwards the upstream host.
# MCP_ALLOWED_HOSTS=saxo-mcp.duckdns.org
